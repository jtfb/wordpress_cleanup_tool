    ("command exec on request data",
     r"\b(system|shell_exec|passthru|exec|popen|proc_open|pcntl_exec)\s*\(\s*(@\s*)?\$_(POST|GET|REQUEST|COOKIE)"),
    ("preg_replace /e modifier", r"preg_replace\s*\(\s*(['\"])[^'\"]{1,200}/[a-z]*e[a-z]*\1"),
    ("known webshell", r"FilesMan|c99shell|r57shell|b374k|IndoXploit|Web Shell by|WSO\s*\d?\.\d"),
    ("gzinflate(base64_decode())", r"gzinflate\s*\(\s*base64_decode"),
    ("huge base64 blob decoded", r"base64_decode\s*\(\s*['\"][A-Za-z0-9+/=]{300,}['\"]"),
]]
MED_PHP = [(l, re.compile(r, re.I)) for l, r in [
    ("eval()", r"\beval\s*\("),
    ("create_function()", r"\bcreate_function\s*\("),
    ("long hex-escaped string", r"(\\x[0-9a-f]{2}){25,}"),
    ("file write of request data", r"file_put_contents\s*\([^;]{0,100}\$_(POST|GET|REQUEST)"),
    ("str_rot13", r"\bstr_rot13\s*\("),
]]
MED_WEB = [(l, re.compile(r, re.I)) for l, r in [
    ("hidden iframe", r"<iframe[^>]{0,200}(width|height)\s*=\s*['\"]?[01]['\"]?[ >'\"]"),
    ("document.write(unescape())", r"document\.write\s*\(\s*unescape"),
    ("long fromCharCode list", r"String\.fromCharCode\((\s*\d+\s*,){20,}"),
]]
CONF_SIGS = [(l, re.compile(r, re.I)) for l, r in [
    ("redirect to external site", r"RewriteRule\s+\S+\s+https?://(?!%\{HTTP_HOST)"),
    ("odd AddHandler for php", r"AddHandler\s+\S*php\S*\s+\.(jpg|jpeg|png|gif|txt|ico)"),
    ("eval/base64 in config", r"eval\(|base64_decode"),
]]
