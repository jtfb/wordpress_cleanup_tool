def tail(path, n=300000):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - n))
            return fh.read().decode("utf-8", "ignore")
    except OSError:
        return ""


def owner_of(path, root):
    parts = os.path.relpath(path, root).replace(os.sep, "/").split("/")
    if len(parts) >= 3 and parts[0] == "wp-content" and parts[1] in ("plugins", "themes"):
        return parts[1], parts[2]
    return None, None


def ancestor_dirs(root):
    home = os.path.expanduser("~").rstrip(os.sep)
    out, d = [root], root
    while d.startswith(home + os.sep):
        d = os.path.dirname(d)
        if d == home or d == os.sep:
            break
        out.append(d)
    return out


def diagnose(root, runs):
