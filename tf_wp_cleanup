    # world-writable items
    ww = 0
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS and not excluded(os.path.join(d, x))]
        for x in dirs + files:
            try:
                if os.stat(os.path.join(d, x)).st_mode & 0o002 and not os.path.islink(os.path.join(d, x)):
                    ww += 1
            except OSError:
                pass
    if ww:
        say("  [!] %d world-writable files/folders (777/666) - hosts often answer these with 500 -> --fix-perms" % ww)
        problems += 1
    # error logs
    logs = [os.path.join(root, "error_log"), os.path.join(root, "wp-admin", "error_log"),
            os.path.join(root, "wp-content", "debug.log"), os.path.join(root, "wp-content", "error_log")]
    for sub in ("plugins", "themes"):
        base = os.path.join(root, "wp-content", sub)
        if os.path.isdir(base):
            logs += [os.path.join(base, x, "error_log") for x in os.listdir(base)]
    seen, errors = set(), []
    for lg in logs:
        if not os.path.isfile(lg):
            continue
        for line in reversed(tail(lg).splitlines()):
            m = FATAL_RX.search(line)
            if not m:
                continue
            req = REQ_RX.search(line)
            key = (m.group(2), req.group(1) if req else line[40:100])
            if key in seen:
                continue
            seen.add(key)
            errors.append((lg, line.strip(), m.group(2), req.group(1) if req else None))
            if len(errors) >= 8:
                break
    if errors:
        say("  Recent fatal errors (newest first):")
    for lg, line, f, req in errors:
        problems += 1
        say("  [!] %s" % re.sub(r"\s*\(include_path='[^']*'\)", "", line)[:330])
        for target in [x for x in (req, f) if x]:
            hit = find_in_quarantine(target, runs)
            if not os.path.exists(target):
                if hit:
                    say("      %s is missing; the script moved/replaced it earlier (%s)." % (target, hit[2]))
                    say("      put it back (after checking it): {TOOL} --undo-file %s" % target)
                else:
                    say("      %s is missing -> reinstall the plugin/theme or run --recover" % target)
        kind, slug = owner_of(f, root)
        if kind:
            flag = "--disable-plugin" if kind == "plugins" else "--disable-theme"
            say("      belongs to %s '%s' -> try: {TOOL} %s %s" % (kind[:-1], slug, flag, slug))
    if not errors:
        say("  No fatal errors found in error logs (logs may be elsewhere: cPanel > Metrics > Errors).")
    if not problems:
        say("  Nothing obviously broken. If you still get a 500: --htaccess, then --disable-all-plugins.")
    say("  Still 500? Order to try: --htaccess -> --fix-perms -> --disable-all-plugins -> --disable-theme <active theme>")


# ---------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(description="Scan, clean and recover hacked WordPress sites")
    ap.add_argument("roots", nargs="*", default=[os.getcwd()],
                    help="folders to scan (default: the folder you are in right now)")
    ap.add_argument("--recover", action="store_true", help="do everything needed to get the site back online")
    ap.add_argument("--scan", action="store_true", help="run the malware scan even when using a recovery tool")
    ap.add_argument("--fix", action="store_true", help="apply scan fixes (default is dry-run)")
    ap.add_argument("--aggressive", action="store_true",
                    help="also quarantine unknown PHP in plugins and files with high-confidence signatures")
    ap.add_argument("--diagnose", action="store_true", help="read error logs and explain the 500 error")
    ap.add_argument("--htaccess", "--reset-htaccess", dest="reset_htaccess", action="store_true",
                    help="rewrite .htaccess with the standard WordPress block (RewriteBase /)")
    ap.add_argument("--rewrite-base", default="/", metavar="PATH",
                    help="for sites in a subfolder, e.g. /blog/ (default /)")
    ap.add_argument("--keep-php-handler", action="store_true",
                    help="with --reset-htaccess: keep the cPanel PHP-version block")
    ap.add_argument("--fix-perms", action="store_true")
    ap.add_argument("--debug", choices=["on", "off"],
                    help="turn WordPress error logging (wp-content/debug.log) on or off; use with --diagnose")
    ap.add_argument("--rebuild-config", action="store_true",
                    help="rebuild a clean wp-config.php from the old settings (new security keys)")
    ap.add_argument("--db-name"); ap.add_argument("--db-user"); ap.add_argument("--db-password")
    ap.add_argument("--db-host"); ap.add_argument("--table-prefix")
    ap.add_argument("--check-admin", action="store_true",
                    help="read-only: check roles/permissions and list users (flags new accounts)")
    ap.add_argument("--fix-admin", metavar="USER",
                    help="give this user (login or ID) the administrator role and rebuild broken roles")
    ap.add_argument("--disable-all-plugins", action="store_true")
    ap.add_argument("--enable-all-plugins", action="store_true")
    ap.add_argument("--disable-plugin", action="append", default=[], metavar="SLUG")
    ap.add_argument("--disable-theme", action="append", default=[], metavar="SLUG")
    ap.add_argument("--strip-conf", action="append", default=[], metavar="FILE")
    ap.add_argument("--quarantine-file", action="append", default=[], metavar="FILE",
                    help="move this file to quarantine right now (reversible with --undo-file)")
    ap.add_argument("--list-quarantine", action="store_true")
    ap.add_argument("--purge-quarantine", type=int, metavar="DAYS",
                    help="permanently delete quarantine runs older than DAYS (asks first; add --yes to skip)")
    ap.add_argument("--yes", action="store_true", help="do not ask for confirmation (for cron)")
    ap.add_argument("--undo-file", metavar="PATH")
    ap.add_argument("--undo-all", nargs="?", const="latest", metavar="RUN")
    ap.add_argument("--exclude", action="append", default=[], metavar="PATH",
                    help="skip this folder everywhere (e.g. --exclude bkp); repeatable")
    ap.add_argument("--days", type=int, default=0, help="also list PHP files modified in the last N days")
    ap.add_argument("--no-cjk", action="store_true", help="do not flag Chinese/Japanese/Korean characters")
    ap.add_argument("--no-network", action="store_true", help="skip official checksum verification")
    ap.add_argument("--quarantine-dir", default=None,
                    help="where moved files go (default: tf_wp_quarantine/ next to this script)")
    ap.add_argument("--reports-dir", default=None,
                    help="where logs/reports go (default: tf_wp_reports/ next to this script)")
    ap.add_argument("--version", action="version", version="tf_wp_cleanup " + __version__)
    args = ap.parse_args()

    if args.recover:
        args.fix = args.reset_htaccess = args.fix_perms = args.diagnose = args.scan = True
    try:
        os.nice(10)  # be gentle with shared hosting
    except (AttributeError, OSError):
        pass

    ts = time.strftime("%Y%m%d_%H%M%S")
    reports_dir = os.path.abspath(args.reports_dir) if args.reports_dir else REPORTS_DIR
    qroot = args.quarantine_dir or os.path.join(QBASE, ts)
    runs = list_runs(args.quarantine_dir)
    ensure_private_dir(reports_dir)
    ensure_private_dir(QBASE)
    if any(part in WEB_DIR_NAMES for part in BASE_DIR.split(os.sep)):
        say("[!] This tool lives inside a web-accessible folder (%s)." % BASE_DIR)
        say("    Move it (and its tf_wp_quarantine/tf_wp_reports folders) outside public_html, e.g. ~/tf_tools/.")
    if not args.list_quarantine:
        try:
            log_path = os.path.join(reports_dir, "run_%s.log" % ts)
            log_fh = open(log_path, "w")
            os.chmod(log_path, 0o600)
            sys.stdout = Tee(sys.stdout, log_fh)
            say("tf_wp_cleanup %s - run log: %s" % (__version__, log_path))
        except OSError:
            pass

    # --- quarantine browsing / undo (no WordPress needed)
    if args.list_quarantine:
        list_quarantine(runs)
        return 0
    if args.purge_quarantine is not None:
        purge_quarantine(args.purge_quarantine, args.yes)
        return 0
    if args.undo_file:
        undo_file(args.undo_file, runs)
        return 0
    if args.undo_all:
        undo_all(args.undo_all, runs)
        return 0
    if args.quarantine_file:
        for f in args.quarantine_file:
            f = os.path.abspath(f)
            if os.path.isfile(f):
                quarantine(f, qroot)
                say("  quarantined: %s  (undo: --undo-file %s)" % (f, f))
            else:
                say("  not a file: %s" % f)
        return 0
    if args.strip_conf:
        for f in args.strip_conf:
            f = os.path.abspath(f)
            n = strip_conf_lines(f, qroot) if os.path.isfile(f) else 0
            say("  %s: removed %d auto_prepend/append line(s)%s" % (f, n, " (backup in %s/replaced)" % qroot if n else ""))
        return 0

    EXCLUDE[:] = [os.path.abspath(e) for e in args.exclude] + [BASE_DIR]   # never scan our own quarantine
    roots = [os.path.abspath(r) for r in args.roots]
    installs = find_installs(roots)
    if not installs:
        say("No WordPress install found in: %s" % ", ".join(roots))
        say("cd into the site's root folder (the one containing wp-includes) and run again.")
        return 1

    tool_mode = any([bool(args.debug), args.rebuild_config, args.check_admin, bool(args.fix_admin), args.diagnose, args.reset_htaccess, args.fix_perms, args.disable_all_plugins,
                     args.enable_all_plugins, args.disable_plugin, args.disable_theme])
    do_scan = args.scan or not tool_mode
    say("Found %d WordPress install(s)" % len(installs))

    # --- quick manual switches first
    for root in installs:
        if args.disable_all_plugins:
            disable_all_plugins(root)
        if args.enable_all_plugins:
            enable_all_plugins(root)
        for s in args.disable_plugin:
            disable_item(root, "plugins", s)
        for s in args.disable_theme:
            disable_item(root, "themes", s)

    if args.debug:
        for root in installs:
            debug_mode(root, args.debug == "on", qroot)
    if args.rebuild_config:
        for root in installs:
            say("\n== REBUILD wp-config.php for %s" % root)
            rebuild_config(root, args, qroot, runs)
    if args.check_admin or args.fix_admin:
        for root in installs:
            say("\n== ADMIN PERMISSIONS for %s" % root)
            admin_tool(root, args.fix_admin, bool(args.fix_admin))
        if args.fix_admin:
            say("\nLog out, clear cookies (or use a private window) and log in again.")

    # --- scan / fix
    lines = []
    if do_scan:
        say("Mode: %s%s" % ("FIX" if args.fix else "DRY-RUN (nothing will be changed)",
                              " + aggressive" if args.aggressive else ""))
        findings, verified = {}, set()
        for root in installs:
            say("\n== %s" % root)
            verify_core(root, findings, verified, not args.no_network)
            verify_plugins(root, findings, verified, not args.no_network)
            review_wp_content(root, findings)
        for root in installs:
            say("\n== scanning %s" % root)
            generic_scan(root, installs, verified, findings, args)

        say("\n================ FINDINGS ================")
        for level in ("HIGH", "MED", "INFO"):
            for path, f in sorted(findings.items()):
                if f["level"] != level:
                    continue
                a = f["action"]
                act = a[0] if isinstance(a, tuple) else (a or "review")
                lines.append("[%s] %s\n      %s   -> %s" % (level, path, "; ".join(f["reasons"]), act))
        say("\n".join(lines) if lines else "Nothing suspicious found.")

        say("\n================ ACTIONS ================")
        done, failed = apply_fixes(findings, args, qroot)
        if args.fix:
            say("\nDone: %d fixed, %d failed. Quarantined files / backups of replaced files: %s" % (done, failed, qroot))

    # --- recovery tools
    if args.reset_htaccess or args.fix_perms:
        say("\n================ RECOVERY ================")
        for root in installs:
            if args.reset_htaccess:
                reset_htaccess(root, qroot, args.rewrite_base, args.keep_php_handler)
            if args.fix_perms:
                fix_perms(root)

    # --- diagnosis (after fixes, so it shows what is still wrong)
    if args.diagnose:
        for root in installs:
            diagnose(root, list_runs(args.quarantine_dir))

    if lines:
        report = os.path.join(reports_dir, "report_%s.txt" % ts)
        try:
            with open(report, "w") as fh:
                fh.write("tf_wp_cleanup %s report, %s\nScanned: %s\n\n" % (
                    __version__, time.strftime("%Y-%m-%d %H:%M:%S"), ", ".join(installs)))
                fh.write("\n".join(lines) + "\n")
            os.chmod(report, 0o600)
            say("\nFindings report saved to %s" % report)
        except OSError:
            pass
    if args.recover:
        say("\nNow load the site. Still broken? Run: {TOOL} --diagnose")
        say("Then change ALL passwords (cPanel, FTP, DB, WordPress admins) and regenerate wp-config.php salts.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
