def list_runs(custom=None):
    if custom:
        return [os.path.abspath(custom)]
    if not os.path.isdir(QBASE):
        return []
    return sorted([os.path.join(QBASE, d) for d in os.listdir(QBASE)
                   if os.path.isdir(os.path.join(QBASE, d))], reverse=True)


def find_in_quarantine(path, runs):
    for run in runs:
        for sub in ("", "replaced"):
            cand = os.path.join(run, sub, path.lstrip("/")) if sub else os.path.join(run, path.lstrip("/"))
            if os.path.isfile(cand):
                return cand, run, sub or "quarantined"
    return None


def run_files(run):
    for d, _, files in os.walk(run):
        for fn in files:
            full = os.path.join(d, fn)
            rel = os.path.relpath(full, run)
            if rel.startswith("replaced" + os.sep):
                rel = rel[len("replaced") + 1:]
            yield full, "/" + rel


def list_quarantine(runs):
    if not runs:
        say("No quarantine runs found in %s" % QBASE)
    for run in runs:
        files = list(run_files(run))
        say("%s  (%d files)" % (run, len(files)))
        for _, orig in files[:200]:
            say("    %s" % orig)


def dir_size(path):
    total = 0
    for d, _, files in os.walk(path):
        for fn in files:
            try:
                total += os.path.getsize(os.path.join(d, fn))
            except OSError:
                pass
    return total


def purge_quarantine(days, assume_yes):
    """Permanently delete quarantine runs older than N days (this is the ONLY place the tool deletes)."""
    if days < 1:
        say("DAYS must be 1 or more.")
        return
    cutoff = time.time() - days * 86400
    old = []
    for run in list_runs():
        try:
            t = time.mktime(time.strptime(os.path.basename(run), "%Y%m%d_%H%M%S"))
        except ValueError:
            t = os.path.getmtime(run)
        if t < cutoff:
            old.append(run)
    if not old:
        say("No quarantine runs older than %d days in %s" % (days, QBASE))
        return
    total = sum(dir_size(r) for r in old)
    say("Quarantine runs older than %d days (%.1f MB):" % (days, total / 1048576.0))
    for r in old:
        say("    %s" % r)
    if not assume_yes:
        try:
            ok = input("Delete these PERMANENTLY? Type YES: ").strip() == "YES"
        except EOFError:
            ok = False
        if not ok:
            say("Cancelled. Nothing deleted.")
            return
    for r in old:
        shutil.rmtree(r, ignore_errors=True)
        say("  deleted %s" % r)


def undo_file(path, runs):
    path = os.path.abspath(path)
    hit = find_in_quarantine(path, runs)
    if not hit:
        say("No quarantined/backup copy of %s" % path)
        return
    cand, run, kind = hit
    os.makedirs(os.path.dirname(path), exist_ok=True)
    shutil.copy2(cand, path)
    os.chmod(path, 0o644)
    say("Restored %s from %s (%s). Copy kept in quarantine." % (path, run, kind))


def undo_all(arg, runs):
    if arg == "latest":
        run = runs[0] if runs else None
    else:
        run = arg if os.path.isdir(arg) else os.path.join(QBASE, arg)
    if not run or not os.path.isdir(run):
        say("Run folder not found.")
        return
    files = list(run_files(run))
    say("This will put back %d files from %s - INCLUDING any malware that was quarantined." % (len(files), run))
    if input("Type YES to continue: ").strip() != "YES":
        say("Cancelled.")
        return
    for full, orig in files:
        os.makedirs(os.path.dirname(orig), exist_ok=True)
        shutil.copy2(full, orig)
        os.chmod(orig, 0o644)
        say("  restored %s" % orig)


