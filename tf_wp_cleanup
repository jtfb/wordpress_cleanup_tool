# ---------------------------------------------------------------- helpers
def http_get(url, timeout=120):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=timeout) as r:
            return r.read()
    except Exception:
        return None


def md5_bytes(b):
    return hashlib.md5(b).hexdigest()


def md5_file(p):
    h = hashlib.md5()
    with open(p, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def snippet(s):
    return re.sub(r"\s+", " ", s)[:80]


def action_rank(a):
    if a is None:
        return 0
    if isinstance(a, tuple):
        return 3
    return {"aggr": 1, "quarantine": 2}[a]


def add(findings, path, level, reason, action=None):
    f = findings.setdefault(path, {"level": "INFO", "reasons": [], "action": None})
    if RANK[level] > RANK[f["level"]]:
        f["level"] = level
    if reason not in f["reasons"]:
        f["reasons"].append(reason)
    if action_rank(action) > action_rank(f["action"]):
        f["action"] = action


def ext_of(name):
    return os.path.splitext(name)[1].lower()


EXCLUDE = []


def excluded(path):
    p = os.path.abspath(path)
    return any(p == e or p.startswith(e + os.sep) for e in EXCLUDE)


def walk(root, prune=()):
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS and os.path.join(d, x) not in prune
                   and not excluded(os.path.join(d, x))]
        for fn in files:
            yield os.path.join(d, fn), fn


def read_text(p, limit=None):
    try:
        with open(p, "rb") as fh:
            return fh.read(limit).decode("utf-8", "ignore") if limit else fh.read().decode("utf-8", "ignore")
    except OSError:
        return ""


def conf_prepends(path):
    """auto_prepend/append_file values in a config file (ignores empty/'none')."""
    vals = []
    for line in read_text(path).splitlines():
        m = AUTO_RX.match(line)
        if m:
            v = m.group(1).strip().strip("\"' ")
            if v and v.lower() != "none":
                vals.append(v)
    return vals


# ---------------------------------------------------------------- WordPress info
def find_installs(roots):
    found = []
    for r in roots:
        for d, dirs, _ in os.walk(r):
            if os.path.isfile(os.path.join(d, "wp-includes", "version.php")):
                found.append(os.path.abspath(d))
            dirs[:] = [x for x in dirs if x not in SKIP_DIRS | {"wp-content", "wp-admin", "wp-includes"}
                       and not excluded(os.path.join(d, x))]
    return sorted(set(found))


def wp_version(root):
    txt = read_text(os.path.join(root, "wp-includes", "version.php"))
    v = re.search(r"\$wp_version\s*=\s*'([^']+)'", txt)
    l = re.search(r"\$wp_local_package\s*=\s*'([^']+)'", txt)
    return (v.group(1) if v else None), (l.group(1) if l else "en_US")


def core_checksums(ver, loc):
    for l in dict.fromkeys([loc, "en_US"]):
        raw = http_get("https://api.wordpress.org/core/checksums/1.0/?version=%s&locale=%s" % (ver, l))
        if not raw:
            continue
        try:
            c = json.loads(raw.decode()).get("checksums")
        except ValueError:
            continue
        if isinstance(c, dict):
            if isinstance(c.get(ver), dict):
                c = c[ver]
            if c:
                return c
    return None


def plugin_version(pdir):
    try:
        for fn in os.listdir(pdir):
            if fn.endswith(".php"):
                m = re.search(r"^[ \t/*#@]*Version:\s*([^\s]+)", read_text(os.path.join(pdir, fn), 8192),
                              re.I | re.M)
                if m:
                    return m.group(1).strip()
    except OSError:
        pass
    return None


def plugin_checksums(slug, ver):
    raw = http_get("https://downloads.wordpress.org/plugin-checksums/%s/%s.json" % (slug, ver), 60)
    if not raw:
        return None
    try:
        files = json.loads(raw.decode()).get("files")
    except ValueError:
        return None
    return files if isinstance(files, dict) else None


# ---------------------------------------------------------------- verification passes
def verify_core(root, findings, verified, use_net):
    ver, loc = wp_version(root)
    if not (ver and use_net):
        add(findings, root, "INFO", "core not verified (no version/network)")
        return
    cks = core_checksums(ver, loc)
    if not cks:
        add(findings, root, "INFO", "no official checksums for WP %s (%s)" % (ver, loc))
        return
    say("  core %s (%s): checking %d files" % (ver, loc, len(cks)))
    for rel, md5 in cks.items():
        if rel.startswith("wp-content/"):
            continue
        p = os.path.join(root, rel)
        act = ("restore_core", ver, loc, rel, md5)
        if not os.path.isfile(p):
            if rel not in SKIP_MISSING:
                add(findings, p, "HIGH", "core file MISSING", act)
        elif md5_file(p) == md5:
            verified.add(p)
        else:
            add(findings, p, "HIGH", "core file modified", act)
    for sub in ("wp-admin", "wp-includes"):
        for p, fn in walk(os.path.join(root, sub)):
            rel = os.path.relpath(p, root).replace(os.sep, "/")
            if rel not in cks and fn not in IGNORE_NAMES and ext_of(fn) in PHP_EXT:
                add(findings, p, "HIGH", "unknown PHP file in core folder", "quarantine")
    try:
        for fn in os.listdir(root):
            p = os.path.join(root, fn)
            if (os.path.isfile(p) and ext_of(fn) in PHP_EXT and fn not in cks and fn != "wp-config.php"):
                add(findings, p, "MED", "unknown PHP file at site root (review; --aggressive quarantines it)", "aggr")
    except OSError:
        pass


def verify_plugins(root, findings, verified, use_net):
    pdir = os.path.join(root, "wp-content", "plugins")
    if not (use_net and os.path.isdir(pdir)):
        return
    for slug in sorted(os.listdir(pdir)):
        d = os.path.join(pdir, slug)
        if not os.path.isdir(d) or slug.endswith(".disabled"):
            continue
        ver = plugin_version(d)
        files = plugin_checksums(slug, ver) if ver else None
        if not files:
            add(findings, d, "INFO", "plugin '%s' not verifiable (premium/custom/unknown version)" % slug)
            continue
        for rel, info in files.items():
            p = os.path.join(d, rel)
            md5s = info.get("md5", [])
            md5s = [md5s] if isinstance(md5s, str) else list(md5s)
            act = ("restore_plugin", slug, ver, rel, md5s)
            if not os.path.isfile(p):
                add(findings, p, "HIGH", "plugin file MISSING (%s %s)" % (slug, ver), act)
            elif md5_file(p) in md5s:
                verified.add(p)
            else:
                add(findings, p, "HIGH", "plugin file modified (%s %s)" % (slug, ver), act)
        for p, fn in walk(d):
            rel = os.path.relpath(p, d).replace(os.sep, "/")
            if rel not in files and ext_of(fn) in PHP_EXT and fn not in IGNORE_NAMES:
                add(findings, p, "MED", "PHP file not part of plugin '%s' (review)" % slug, "aggr")


def review_wp_content(root, findings):
    """mu-plugins and drop-ins are favourite hiding places: list them for review."""
    wc = os.path.join(root, "wp-content")
    mu = os.path.join(wc, "mu-plugins")
    if os.path.isdir(mu):
        for p, fn in walk(mu):
            if ext_of(fn) in PHP_EXT:
                add(findings, p, "MED", "must-use plugin (loads on every request; confirm you know it)")
    for fn in ("advanced-cache.php", "object-cache.php", "db.php", "db-error.php", "maintenance.php"):
        p = os.path.join(wc, fn)
        if os.path.isfile(p):
            add(findings, p, "MED", "WordPress drop-in (confirm it belongs to a plugin you use)")
    try:
        for fn in os.listdir(wc):
            p = os.path.join(wc, fn)
            if os.path.isfile(p) and ext_of(fn) in PHP_EXT and fn not in (
                    "index.php", "advanced-cache.php", "object-cache.php", "db.php", "db-error.php", "maintenance.php"):
                add(findings, p, "MED", "unexpected PHP file directly in wp-content (review)")
    except OSError:
        pass


# ---------------------------------------------------------------- generic scan
def scan_file(path, name, in_uploads, cjk):
    hits = []
    ext = ext_of(name)
    try:
        size = os.path.getsize(path)
    except OSError:
        return hits
    is_php = ext in PHP_EXT
    if in_uploads and is_php and not (name == "index.php" and size < 200):
        hits.append(("HIGH", "PHP file inside uploads", "quarantine"))
    img = ext in IMG_EXT
    if not (ext in CODE_EXT or name in CONF_NAMES or img):
        return hits
    if size > (1000000 if img else MAX_SIZE):
        return hits
    text = read_text(path)
    if img:
        if "<?php" in text.lower():
            hits.append(("HIGH", "PHP code hidden in %s file" % ext, "quarantine" if in_uploads else "aggr"))
        return hits
    if name in CONF_NAMES:
        bad = [v for v in conf_prepends(path) if "wordfence-waf" not in v]
        if bad:
            hits.append(("HIGH", "auto_prepend/append_file -> %s" % ", ".join(bad)[:80], ("strip_conf",)))
        for label, rx in CONF_SIGS:
            m = rx.search(text)
            if m:
                hits.append(("MED", "%s: %s (review; --reset-htaccess replaces it)" % (label, snippet(m.group(0))), None))
        return hits
    for label, rx in HIGH_SIGS:
        m = rx.search(text)
        if m:
            hits.append(("HIGH", "%s: %s" % (label, snippet(m.group(0))), "aggr"))
    if is_php:
        for label, rx in MED_PHP:
            if rx.search(text):
                hits.append(("MED", label, None))
        if any(len(line) > 5000 for line in text.split("\n")):
            hits.append(("MED", "very long line (possible obfuscation)", None))
    if ext in (".php", ".js", ".html", ".htm"):
        for label, rx in MED_WEB:
            if rx.search(text):
                hits.append(("MED", label, None))
    if cjk:
        m = CJK.search(text)
        if m:
            hits.append(("MED", "CJK characters: " + m.group(0)[:20], None))
    return hits


def generic_scan(root, all_roots, verified, findings, args):
    prune = set(r for r in all_roots if r != root)
    cutoff = time.time() - args.days * 86400 if args.days else None
    n = 0
    for p, fn in walk(root, prune):
        if p in verified or os.path.islink(p):
            continue
        n += 1
        in_up = (os.sep + "wp-content" + os.sep + "uploads" + os.sep) in p
        for level, reason, action in scan_file(p, fn, in_up, not args.no_cjk):
            if fn == "wp-config.php" and action:
                action, reason = None, reason + " (wp-config.php is never moved automatically: use --rebuild-config)"
            add(findings, p, level, reason, action)
        if cutoff and ext_of(fn) in PHP_EXT:
            try:
                if os.path.getmtime(p) > cutoff:
                    add(findings, p, "INFO", "modified in the last %d days" % args.days)
            except OSError:
                pass
    say("  scanned %d files" % n)


# ---------------------------------------------------------------- fixing
def quarantine(path, qroot):
    dest = os.path.join(qroot, path.lstrip("/"))
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    shutil.move(path, dest)
    os.chmod(dest, 0o600)


def backup(path, qroot):
    if not os.path.isfile(path):
        return
    dest = os.path.join(qroot, "replaced", path.lstrip("/"))
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    shutil.copy2(path, dest)
    os.chmod(dest, 0o600)


def write_atomic(path, data, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".wpclean.tmp"
    with open(tmp, "wb") as fh:
        fh.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def get_zip(key, urls, cache):
    if key not in cache:
        cache[key] = None
        for u in urls:
            data = http_get(u, 300)
            if data:
                cache[key] = data
                break
    return cache[key]


def restore(path, act, cache, qroot):
    if act[0] == "restore_core":
        _, ver, loc, rel, md5 = act
        urls = []
        if loc != "en_US":
            urls.append("https://downloads.wordpress.org/release/%s/wordpress-%s.zip" % (loc, ver))
        urls.append("https://wordpress.org/wordpress-%s.zip" % ver)
        z = get_zip(("core", ver, loc), urls, cache)
        member, expected = "wordpress/" + rel, [md5]
    else:
        _, slug, ver, rel, md5s = act
        z = get_zip(("plugin", slug, ver),
                    ["https://downloads.wordpress.org/plugin/%s.%s.zip" % (slug, ver)], cache)
        member, expected = slug + "/" + rel, md5s
    if not z:
        raise RuntimeError("could not download official ZIP")
    with zipfile.ZipFile(io.BytesIO(z)) as zf:
        data = zf.read(member)
    if md5_bytes(data) not in expected:
        raise RuntimeError("ZIP copy does not match official checksum; skipped")
    backup(path, qroot)
    write_atomic(path, data)


def strip_conf_lines(path, qroot):
    lines = read_text(path).splitlines(True)
    keep, removed = [], 0
    for line in lines:
        m = AUTO_RX.match(line)
        v = m.group(1).strip().strip("\"' ") if m else ""
        if m and v and v.lower() != "none" and "wordfence-waf" not in v:
            removed += 1
        else:
            keep.append(line)
    if removed:
        backup(path, qroot)
        write_atomic(path, "".join(keep).encode("utf-8"))
    return removed


def apply_fixes(findings, args, qroot):
    cache, done, failed = {}, 0, 0
    for path, f in sorted(findings.items()):
        a = f["action"]
        if isinstance(a, tuple):
            do = a
        elif a == "quarantine" or (a == "aggr" and args.aggressive):
            do = ("quarantine",)
        else:
            continue
        if os.path.basename(path) == "wp-config.php" and do[0] == "quarantine":
            continue
        label = {"restore_core": "restore", "restore_plugin": "restore",
                 "strip_conf": "strip auto_prepend lines in", "quarantine": "quarantine"}[do[0]]
        if not args.fix:
            say("  [dry-run] would %s: %s" % (label, path))
            continue
        try:
            if do[0] == "quarantine":
                quarantine(path, qroot)
            elif do[0] == "strip_conf":
                strip_conf_lines(path, qroot)
            else:
                restore(path, do, cache, qroot)
            say("  %s: %s" % (label, path))
            done += 1
        except Exception as e:
            say("  FAILED %s %s: %s" % (label, path, e))
            failed += 1
    return done, failed


# ---------------------------------------------------------------- recovery tools
CPANEL_BLOCK = re.compile(r"# php -- BEGIN cPanel-generated handler.*?# php -- END cPanel-generated handler, do not edit[ \t]*\n?", re.S)


def reset_htaccess(root, qroot, base="/", keep_php=False):
    p = os.path.join(root, ".htaccess")
    old = read_text(p) if os.path.isfile(p) else ""
    keep = ""
    if keep_php:
        m = CPANEL_BLOCK.search(old)
        if m and not re.search(r"eval|base64|auto_prepend|https?:|\.(jpe?g|png|gif|txt|ico)\b", m.group(0), re.I):
            keep = m.group(0).rstrip("\n") + "\n\n"
    base = "/" + base.strip("/") + "/" if base.strip("/") else "/"
    backup(p, qroot)
    write_atomic(p, (keep + DEFAULT_HTACCESS.format(base=base)).encode())
    say("  .htaccess rewritten (RewriteBase %s)%s: %s  (old copy in %s/replaced)" % (
        base, " + kept cPanel PHP-version block" if keep else "", p, qroot))


def fix_perms(root):
    n = 0
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS and not excluded(os.path.join(d, x))]
        items = [(os.path.join(d, x), 0o755) for x in dirs] + [
            (os.path.join(d, x), 0o600 if (x == "wp-config.php" and d == root) else 0o644) for x in files]
        for p, want in items:
            try:
                if os.path.islink(p):
                    continue
                if (os.stat(p).st_mode & 0o777) != want:
                    os.chmod(p, want)
                    n += 1
            except OSError:
                pass
    say("  permissions fixed on %d items under %s" % (n, root))


