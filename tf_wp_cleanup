def find_php():
    cands = [shutil.which("php")] + sorted(glob.glob("/opt/cpanel/ea-php*/root/usr/bin/php"), reverse=True) + [
        "/usr/local/bin/php", "/usr/bin/php"]
    for c in cands:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def admin_tool(root, who, apply_):
    """Check (or repair) administrator permissions by loading WordPress itself from the command line."""
    php = find_php()
    if not php:
        say("  php command-line not found; use the phpMyAdmin SQL method instead.")
        return
    wl = os.path.join(root, "wp-load.php")
    if not os.path.isfile(wl):
        say("  wp-load.php missing in %s (run --recover first)" % root)
        return
    script = os.path.expanduser("~/.tf_wpclean_admin_%d.php" % os.getpid())
    try:
        with open(script, "w") as fh:
            fh.write(ADMIN_PHP)
        os.chmod(script, 0o600)
        r = subprocess.run([php, "-d", "display_errors=1", "-d", "error_reporting=1", script, wl, who or "",
                            "apply" if apply_ else "check"], cwd=root, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, universal_newlines=True, timeout=180)
        out = r.stdout
        if "<html" in out.lower() or "<body" in out.lower():
            out = re.sub(r"<style.*?</style>", " ", out, flags=re.S | re.I)
            out = re.sub(r"<[^>]+>", "\n", out)
        out = "\n".join(l.strip() for l in out.splitlines() if l.strip())
        say("\n".join("  " + l for l in out.splitlines()) if out else "  (no output)")
        m = re.search(r"PHP FATAL:.* in (/\S+?\.php):\d+", out)
        if m:
            kind, slug = owner_of(m.group(1), root)
            if kind:
                flag = "--disable-plugin" if kind == "plugins" else "--disable-theme"
                say("  -> the crash is inside %s '%s': {TOOL} %s %s" % (kind[:-1], slug, flag, slug))
            else:
                say("  -> the crash is in %s. If it is a core file run --fix; if it is wp-config.php run --rebuild-config." % m.group(1))
        elif r.returncode not in (0, 2, 3):
            say("  WordPress could not load even with plugins skipped: the theme or a core file is broken.")
            say("  Try: --fix (restores core), then --disable-theme <active theme>.")
    except Exception as e:
        say("  failed: %s" % e)
    finally:
        try:
            os.remove(script)
        except OSError:
            pass


KEEP_DEFINES = ["WP_HOME", "WP_SITEURL", "WP_CACHE", "WP_MEMORY_LIMIT", "WP_MAX_MEMORY_LIMIT", "FS_METHOD",
                "DISALLOW_FILE_EDIT", "FORCE_SSL_ADMIN", "WP_POST_REVISIONS", "AUTOMATIC_UPDATER_DISABLED",
                "WP_AUTO_UPDATE_CORE", "COOKIE_DOMAIN", "WPLANG", "EMPTY_TRASH_DAYS"]
SALT_NAMES = ["AUTH_KEY", "SECURE_AUTH_KEY", "LOGGED_IN_KEY", "NONCE_KEY",
              "AUTH_SALT", "SECURE_AUTH_SALT", "LOGGED_IN_SALT", "NONCE_SALT"]
PHP_STR = r"""(['"])((?:\\.|(?!\1).)*)\1"""


def php_unquote(q, body):
    if q == "'":
        return re.sub(r"\\([\\'])", r"\1", body)
    return re.sub(r'\\(["\\$])', r"\1", body)


def php_quote(v):
    return "'" + v.replace("\\", "\\\\").replace("'", "\\'") + "'"


def parse_config(text):
    """Pull the database settings and a few safe constants out of an (even infected) wp-config.php."""
    vals = {}
    for name in ("DB_NAME", "DB_USER", "DB_PASSWORD", "DB_HOST", "DB_CHARSET", "DB_COLLATE"):
        m = re.search(r"define\s*\(\s*['\"]%s['\"]\s*,\s*" % name + PHP_STR, text)
        if m:
            vals[name] = php_unquote(m.group(1), m.group(2))
    m = re.search(r"\$table_prefix\s*=\s*" + PHP_STR, text)
    prefix = php_unquote(m.group(1), m.group(2)) if m else None
    extras = []
    for name in KEEP_DEFINES:
        m = re.search(r"define\s*\(\s*['\"]%s['\"]\s*,\s*(true|false|TRUE|FALSE|\d+|'[^'\\\n]*'|\"[^\"\\\n$]*\")\s*\)" % name, text)
        if m:
            extras.append((name, m.group(1)))
    handled = set(["DB_NAME", "DB_USER", "DB_PASSWORD", "DB_HOST", "DB_CHARSET", "DB_COLLATE", "ABSPATH"]) | \
        set(SALT_NAMES) | set(n for n, _ in extras)
    others = sorted(set(n for n in re.findall(r"define\s*\(\s*['\"](\w+)['\"]", text) if n not in handled))
    return vals, prefix, extras, others


def build_config(vals, prefix, extras):
    rnd = random.SystemRandom()
    chars = string.ascii_letters + string.digits + "!@#%^&*()-_=+[]{}<>~,.;:|/?"
    salts = "\n".join("define( '%s', %s );" % (n, php_quote("".join(rnd.choice(chars) for _ in range(64))))
                      for n in SALT_NAMES)
    ex = "".join("define( '%s', %s );\n" % (n, v) for n, v in extras)
    return ("<?php\n/** wp-config.php rebuilt by tf_wp_cleanup.py */\n"
            "define( 'DB_NAME', %s );\ndefine( 'DB_USER', %s );\ndefine( 'DB_PASSWORD', %s );\n"
            "define( 'DB_HOST', %s );\ndefine( 'DB_CHARSET', %s );\ndefine( 'DB_COLLATE', %s );\n\n"
            "%s\n\n$table_prefix = %s;\n\n%sdefine( 'WP_DEBUG', false );\n\n"
            "if ( ! defined( 'ABSPATH' ) ) {\n\tdefine( 'ABSPATH', __DIR__ . '/' );\n}\n"
            "require_once ABSPATH . 'wp-settings.php';\n") % (
        php_quote(vals["DB_NAME"]), php_quote(vals["DB_USER"]), php_quote(vals["DB_PASSWORD"]),
        php_quote(vals.get("DB_HOST", "localhost")), php_quote(vals.get("DB_CHARSET", "utf8mb4")),
        php_quote(vals.get("DB_COLLATE", "")), salts, php_quote(prefix), ex)


def config_location(root):
    """WordPress accepts wp-config.php in the site folder, or one level above it."""
    here = os.path.join(root, "wp-config.php")
    parent_dir = os.path.dirname(root)
    above = os.path.join(parent_dir, "wp-config.php")
    if os.path.isfile(here):
        return here, "site folder"
    if os.path.isfile(above) and not os.path.isfile(os.path.join(parent_dir, "wp-settings.php")):
        return above, "parent folder"
    return None, None


def rebuild_config(root, args, qroot, runs):
    existing, where = config_location(root)
    target = existing or os.path.join(root, "wp-config.php")
    src = existing
    if not src:
        hit = find_in_quarantine(target, runs)
        if hit:
            src = hit[0]
            say("  wp-config.php is missing; reading the old settings from the quarantine copy: %s" % src)
    vals, prefix, extras, others = ({}, None, [], [])
    if src:
        vals, prefix, extras, others = parse_config(read_text(src))
    for k, a in (("DB_NAME", args.db_name), ("DB_USER", args.db_user),
                 ("DB_PASSWORD", args.db_password), ("DB_HOST", args.db_host)):
        if a is not None:
            vals[k] = a
    if args.table_prefix is not None:
        prefix = args.table_prefix
    missing = [k for k in ("DB_NAME", "DB_USER", "DB_PASSWORD") if k not in vals]
    if prefix is None:
        missing.append("table prefix")
    if missing:
        say("  Could not find: %s" % ", ".join(missing))
        say("  Get them from cPanel > MySQL Databases (name/user) and phpMyAdmin (table prefix), then run e.g.:")
        say("  {TOOL} --rebuild-config --db-name NAME --db-user USER "
              "--db-password 'PASS' --table-prefix wp_")
        return
    if os.path.isfile(target):
        backup(target, qroot)
    write_atomic(target, build_config(vals, prefix, extras).encode("utf-8"), 0o600)
    say("  wp-config.php rebuilt: %s" % target)
    say("    database: %s   user: %s   host: %s   table prefix: %s" % (
        vals["DB_NAME"], vals["DB_USER"], vals.get("DB_HOST", "localhost"), prefix))
    if vals.get("DB_HOST", "localhost") not in ("localhost", "127.0.0.1"):
        say("    [!] DB_HOST is not localhost - check this is really your database server (attackers change it).")
    if extras:
        say("    kept settings (check the values, esp. WP_HOME / WP_SITEURL): %s" % ", ".join("%s=%s" % (n, v) for n, v in extras))
    if others:
        say("    NOT copied (review if you need them): %s" % ", ".join(others))
    say("    new security keys generated: everyone is logged out, which is what you want after an attack.")
    if existing:
        say("    old file backed up in %s/replaced" % qroot)


def debug_mode(root, on, qroot):
    """Turn WordPress error logging (wp-content/debug.log) on/off safely, without showing errors to visitors."""
    cfg, _ = config_location(root)
    if not cfg:
        say("  wp-config.php not found; run --rebuild-config first")
        return
    text = read_text(cfg)
    text = re.sub(r"\n?// [A-Z]{2,8}-DEBUG-BEGIN.*?// [A-Z]{2,8}-DEBUG-END\n?", "\n", text, flags=re.S)
    text = re.sub(r"^// [A-Z]{2,8}-DISABLED: ", "", text, flags=re.M)
    if on:
        text = re.sub(r"^([ \t]*define\s*\(\s*['\"]WP_DEBUG(?:_LOG|_DISPLAY)?['\"].*)$", r"// TF-DISABLED: \1",
                      text, flags=re.M)
        block = ("// TF-DEBUG-BEGIN\ndefine( 'WP_DEBUG', true );\ndefine( 'WP_DEBUG_LOG', true );\n"
                 "define( 'WP_DEBUG_DISPLAY', false );\n// TF-DEBUG-END\n")
        m = re.search(r"^[^\n]*(That's all, stop editing|require_once[^\n]*wp-settings\.php)", text, re.M)
        if not m:
            say("  could not find where to insert the debug lines in %s; add WP_DEBUG_LOG by hand" % cfg)
            return
        text = text[:m.start()] + block + text[m.start():]
    backup(cfg, qroot)
    write_atomic(cfg, text.encode("utf-8"), 0o600)
    if on:
        say("  debug logging ON for %s  (errors go to wp-content/debug.log, visitors see nothing)" % root)
        say("  Now reproduce the problem (open the page editor), then run: {TOOL} --diagnose")
        say("  When finished: {TOOL} --debug off")
    else:
        say("  debug logging OFF for %s (original settings restored)" % root)


