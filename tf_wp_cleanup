def ensure_private_dir(path):
    """Create a folder only the owner can use, and block web access in case it sits in a web folder."""
    os.makedirs(path, exist_ok=True)
    try:
        os.chmod(path, 0o700)
        ht = os.path.join(path, ".htaccess")
        if not os.path.exists(ht):
            with open(ht, "w") as fh:
                fh.write(DENY_HTACCESS)
    except OSError:
        pass


class Tee(object):
    """Copy everything printed on screen into the run log."""
    def __init__(self, stream, fh):
        self.stream, self.fh = stream, fh

    def write(self, s):
        self.stream.write(s)
        try:
            self.fh.write(s)
        except (OSError, ValueError):
            pass

    def flush(self):
        self.stream.flush()
        try:
            self.fh.flush()
        except (OSError, ValueError):
            pass


HIGH_SIGS = [(l, re.compile(r, re.I)) for l, r in [
    ("eval of decoded payload",
     r"\b(eval|assert)\s*\(\s*(@\s*)?(base64_decode|gzinflate|gzuncompress|gzdecode|str_rot13|rawurldecode|hex2bin|convert_uudecode)\s*\("),
